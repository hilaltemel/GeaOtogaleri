@model Car_Dealership.Models.Car
@{
    ViewData["Title"] = "Aracı Düzenle";
}

<div class="container mt-5 pt-3 mb-5">
    
    <!-- Başlık ve Geri Dön Butonu -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold" style="color: #112848;">Araç Bilgilerini Güncelle</h3>
        <a asp-action="Index" class="btn btn-outline-secondary shadow-sm">
            <i class="bi bi-arrow-left me-1"></i> Listeye Dön
        </a>
    </div>

    <!-- Form Kartı -->
    <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
        <div class="card-body p-4 p-md-5 bg-white">
            
            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="Id" />

                <div class="form-group mb-3">
                    <label asp-for="IsSecondHand" class="control-label fw-bold">Araç Durumu</label>
                    <select asp-for="IsSecondHand" class="form-select" id="IsSecondHandSelect">
                        <option value="false">Sıfır Araç</option>
                        <option value="true">İkinci El Araç</option>
                    </select>
                </div>
                                
                <!-- Marka ve Model -->
                <div class="row g-4 mb-4">
                    <div class="col-md-6">
                        <label asp-for="BrandId" class="form-label text-muted small fw-bold text-uppercase" style="letter-spacing: 0.5px;">Marka</label>
                        <select asp-for="BrandId" class="form-select form-select-lg shadow-none fs-6" asp-items="ViewBag.Brands"></select>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="CarModelId" class="form-label text-muted small fw-bold text-uppercase" style="letter-spacing: 0.5px;">Model</label>
                        <select asp-for="CarModelId" class="form-select form-select-lg shadow-none fs-6" asp-items="ViewBag.Models"></select>
                    </div>
                </div>
                <!-- Yeni Ortak Özellikler -->
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Series" class="control-label">Seri</label>
                        <input asp-for="Series" class="form-control" placeholder="Örn: M Sport, Urban vb." />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Year" class="control-label">Yıl</label>
                        <input asp-for="Year" class="form-control" placeholder="Örn: 2023" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="EnginePower" class="control-label">Motor Gücü (HP)</label>
                        <input asp-for="EnginePower" class="form-control" placeholder="Örn: 120" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="EngineCapacity" class="control-label">Motor Hacmi (cc)</label>
                        <input asp-for="EngineCapacity" class="form-control" placeholder="Örn: 1400" />
                    </div>
                    
                    <!-- Enum'lar için otomatik Dropdown (Seçim) Menüleri -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="BodyType" class="control-label">Kasa Tipi</label>
                        <select asp-for="BodyType" class="form-select" asp-items="Html.GetEnumSelectList<Car_Dealership.Models.BodyType>()">
                            <option value="">Seçiniz...</option>
                        </select>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Drivetrain" class="control-label">Çekiş Tipi</label>
                        <select asp-for="Drivetrain" class="form-select" asp-items="Html.GetEnumSelectList<Car_Dealership.Models.Drivetrain>()">
                            <option value="">Seçiniz...</option>
                        </select>
                    </div>
                    <div class="col-md-12 mb-3">
                        <div class="form-check form-switch">
                            <input asp-for="HasWarranty" class="form-check-input" type="checkbox" />
                            <label asp-for="HasWarranty" class="form-check-label">Fabrika/Bayi Garantisi Var Mı?</label>
                        </div>
                    </div>
                </div>

                <!-- Sadece İkinci El Alanları (Başlangıçta JavaScript ile gizlenecek/gösterilecek) -->
                <div id="secondHandSection" class="p-3 mb-4 rounded border bg-light" style="display: none;">
                    <h5 class="text-secondary mb-3"><i class="bi bi-car-front"></i> İkinci El Detayları</h5>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Mileage" class="control-label">Kilometre</label>
                            <input asp-for="Mileage" class="form-control" placeholder="Örn: 45000" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Plate" class="control-label">Plaka</label>
                            <input asp-for="Plate" class="form-control" placeholder="Örn: 34 ABC 123" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="PaintAndChangedStatus" class="control-label">Boya ve Değişen</label>
                            <input asp-for="PaintAndChangedStatus" class="form-control" placeholder="Örn: Sağ ön çamurluk boyalı" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="InspectionDate" class="control-label">Muayene Tarihi</label>
                            <input asp-for="InspectionDate" type="date" class="form-control" />
                        </div>
                        
                        <!-- Düzeltilmiş Güvenli Dropdown'lar -->
                        <div class="col-md-6 mb-3">
                            <label asp-for="HeavyDamageRecord" class="control-label text-danger fw-bold">Ağır Hasar Kaydı</label>
                            <select asp-for="HeavyDamageRecord" class="form-select">
                                <option value="">Belirtilmemiş</option>
                                <option value="true">Var</option>
                                <option value="false">Yok</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="IsTradeInEligible" class="control-label text-success fw-bold">Takas Durumu</label>
                            <select asp-for="IsTradeInEligible" class="form-select">
                                <option value="">Belirtilmemiş</option>
                                <option value="true">Takasa Uygun</option>
                                <option value="false">Takasa Uygun Değil</option>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- Renk -->
                <div class="mb-4">
                    <label asp-for="Color" class="form-label text-muted small fw-bold text-uppercase" style="letter-spacing: 0.5px;">Renk</label>
                    <input asp-for="Color" class="form-control form-control-lg shadow-none fs-6" />
                </div>

                <!-- Vites ve Yakıt -->
                <div class="row g-4 mb-4">
                    <div class="col-md-6">
                        <label asp-for="TransmissionType" class="form-label text-muted small fw-bold text-uppercase" style="letter-spacing: 0.5px;">Vites Tipi</label>
                        <select asp-for="TransmissionType" class="form-select form-select-lg shadow-none fs-6" asp-items="Html.GetEnumSelectList<Car_Dealership.Models.TransmissionType>()"></select>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="FuelType" class="form-label text-muted small fw-bold text-uppercase" style="letter-spacing: 0.5px;">Yakıt Tipi</label>
                        <select asp-for="FuelType" class="form-select form-select-lg shadow-none fs-6" asp-items="Html.GetEnumSelectList<Car_Dealership.Models.FuelType>()"></select>
                    </div>
                </div>

                <!-- Fiyatlar -->
                <div class="row g-4 mb-4">
                    <div class="col-md-6">
                        <label asp-for="FirstPrice" class="form-label text-muted small fw-bold text-uppercase" style="letter-spacing: 0.5px;">İlk Kayıt Fiyatı (₺)</label>
                        <input asp-for="FirstPrice" class="form-control form-control-lg shadow-none fs-6" type="number" step="0.01" readonly/>
                        <small class="text-muted mt-2 d-block"><i class="bi bi-info-circle me-1"></i> İndirim oranını hesaplamak için bu fiyat sabit tutulur.</small>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="CurrentPrice" class="form-label small fw-bold text-uppercase" style="letter-spacing: 0.5px; color: #112848;">Güncel / Satış Fiyatı (₺)</label>
                        <input asp-for="CurrentPrice" class="form-control form-control-lg shadow-none fs-6 fw-bold" style="border: 2px solid rgba(17, 40, 72, 0.2);" type="number" step="0.01" />
                    </div>
                </div>

                <!-- Modern Checkbox'lar (Toggle Switch) -->
                <div class="d-flex gap-5 mb-5 p-3 rounded-3" style="background-color: #f8f9fa;">
                    <div class="form-check form-switch fs-5">
                        <input asp-for="IsShowcase" class="form-check-input shadow-none" type="checkbox" role="switch" />
                        <label asp-for="IsShowcase" class="form-check-label ms-2" style="font-size: 1rem; color: #112848;">Ana Sayfa Vitrininde Göster</label>
                    </div>
                    <div class="form-check form-switch fs-5">
                        <input asp-for="IsOnSale" class="form-check-input shadow-none" type="checkbox" role="switch" />
                        <label asp-for="IsOnSale" class="form-check-label ms-2" style="font-size: 1rem; color: #112848;">Satışta mı?</label>
                    </div>
                </div>

                <!-- Fotoğraf Yükleme Alanı -->
                <div class="p-4 mb-5 rounded-3 text-center" style="background-color: rgba(17, 40, 72, 0.02); border: 2px dashed rgba(17, 40, 72, 0.3);">
                    <i class="bi bi-cloud-arrow-up-fill fs-2 mb-2" style="color: #112848;"></i>
                    <h6 class="fw-bold mb-3" style="color: #112848;">Yeni Fotoğraflar Ekle (Opsiyonel)</h6>
                    <input type="file" name="newImages" multiple class="form-control shadow-none mx-auto mb-2" style="max-width: 400px;" />
                    <small class="text-muted">Eğer buraya yeni bir fotoğraf yüklemezseniz, arabanın mevcut fotoğrafları korunacaktır.</small>
                </div>

                <!-- Butonlar -->
                <div class="d-flex gap-3">
                    <button type="submit" class="btn text-white fw-bold px-5 py-3 shadow-sm" style="background-color: #112848; font-size: 1.05rem;">
                        <i class="bi bi-check2-circle me-2"></i> Değişiklikleri Kaydet
                    </button>
                    <a asp-action="Index" class="btn btn-light fw-bold px-5 py-3 text-muted border shadow-sm" style="font-size: 1.05rem;">İptal</a>
                </div>

            </form>
        </div>
    </div>
</div>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        $(document).ready(function () {
            var conditionSelect = $("#IsSecondHandSelect");
            var secondHandSection = $("#secondHandSection");

            function toggleSecondHandFields() {
                // ASP.NET Core bazen bool değerleri "True" gönderebilir, 
                // bu yüzden toLowerCase() ile sağlama alıyoruz.
                if (conditionSelect.val().toLowerCase() === "true") {
                    secondHandSection.fadeIn('fast'); // Animasyonlu açılış
                } else {
                    secondHandSection.fadeOut('fast'); // Animasyonlu kapanış
                }
            }

            // Sayfa ilk yüklendiğinde, aracın mevcut durumuna göre kutuyu aç veya gizle
            toggleSecondHandFields();

            // Kullanıcı seçimi değiştirdiğinde anlık olarak tetikle
            conditionSelect.change(toggleSecondHandFields);
        });
    </script>
}