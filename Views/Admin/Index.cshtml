@model List<Car_Dealership.Models.Car>
@{
    ViewData["Title"] = "Yönetim Paneli";
}

<div class="container mt-5 pt-3 mb-5">
    <div class="row">
        
        <!-- SOL KOLON: BUTON VE FİLTRE -->
        <div class="col-lg-3 mb-4">
            
            <!-- Yeni Araba Ekle Butonu -->
            <a asp-action="Create" class="btn text-white fw-bold shadow-sm w-100 mb-4" style="background-color: #112848; padding: 12px; font-size: 1.05rem;">
                <i class="bi bi-plus-circle me-2"></i>Yeni Araba Ekle
            </a>

            <!-- Filtreleme Alanı -->
            <div class="card shadow-sm border-0" style="background-color: #f8f9fa;">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                    <h5 class="fw-bold" style="color: #112848;"><i class="bi bi-funnel-fill me-2"></i>Filtrele</h5>
                </div>
                <div class="card-body">
                    <!-- Form Admin Controller'a istek atar -->
                    <form asp-controller="Admin" asp-action="Index" method="get">
                        <div class="mb-3">
                            <label class="form-label text-muted small fw-bold">Marka</label>
                            <select name="brandId" class="form-select form-select-sm shadow-none">
                                <option value="">Tüm Markalar</option>
                                @foreach (var brand in ViewBag.Brands)
                                {
                                    <option value="@brand.Id">@brand.Name</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-muted small fw-bold">Fiyat Aralığı (TL)</label>
                            <div class="d-flex gap-2">
                                <input type="number" name="minPrice" class="form-control form-control-sm shadow-none" placeholder="Min" min="0">
                                <input type="number" name="maxPrice" class="form-control form-control-sm shadow-none" placeholder="Max" min="0">
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-muted small fw-bold">Vites Tipi</label>
                            <select name="transmissionType" class="form-select form-select-sm shadow-none">
                                <option value="">Tümü</option>
                                <option value="1">Manuel</option>
                                <option value="2">Otomatik</option>
                            </select>
                        </div>
                        <div class="mb-4">
                            <label class="form-label text-muted small fw-bold">Yakıt Tipi</label>
                            <select name="fuelType" class="form-select form-select-sm shadow-none">
                                <option value="">Tümü</option>
                                <option value="1">Benzin</option>
                                <option value="2">Dizel</option>
                                <option value="3">Hibrit</option>
                                <option value="4">Elektrik</option>
                            </select>
                        </div>
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn text-white fw-bold shadow-sm" style="background-color: #112848;">Sonuçları Göster</button>
                            <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary btn-sm">Filtreleri Temizle</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- SAĞ KOLON: ARAÇ KARTLARI -->
        <div class="col-lg-9">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4 class="fw-bold mb-0" style="color: #112848;">SİSTEMDEKİ ARAÇLAR</h4>
                <span class="badge text-bg-secondary px-3 py-2">@Model.Count Araç Bulundu</span>
            </div>

            @if (Model.Any())
            {
                <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                    @foreach (var car in Model)
                    {
                        <div class="col">
                            <div class="card h-100 shadow-sm border-0 transition-hover">
                                
                                <!-- Tıklanabilir Detay Alanı (Düzenle ve Sil dışındaki kısım) -->
                                <a asp-action="Details" asp-route-id="@car.Id" class="text-dark text-decoration-none d-block">
                                    @{ var kapakResmi = car.Images?.FirstOrDefault()?.ImagePath; }
                                    @if (!string.IsNullOrEmpty(kapakResmi))
                                    {
                                        <img src="~/images/@kapakResmi" class="card-img-top rounded-top" alt="Araç Görseli" style="height: 180px; object-fit: cover;">
                                    }
                                    else
                                    {
                                        <div class="card-img-top rounded-top bg-secondary d-flex align-items-center justify-content-center text-white" style="height: 180px;">
                                            <i class="bi bi-camera fs-1"></i>
                                        </div>
                                    }

                                    <div class="card-body d-flex flex-column pt-3 pb-2">
                                        <p class="text-muted mb-1 text-uppercase" style="font-size: 0.70rem; letter-spacing: 1px;">
                                            @car.Brand?.Name
                                        </p>
                                        <h6 class="card-title fw-bold text-dark mb-3 text-truncate">
                                            @car.CarModel?.Name
                                        </h6>
                                        <div class="mt-auto pt-2 border-top">
                                            <h5 class="fw-bold m-0" style="color: #112848; font-size: 1.05rem;">@car.CurrentPrice.ToString("N0") TL</h5>
                                        </div>
                                    </div>
                                </a>

                                <!-- Kart Alt İşlem Butonları -->
                                <div class="card-footer bg-white border-0 pt-0 pb-3 d-flex gap-2">
                                    <a asp-action="Edit" asp-route-id="@car.Id" class="btn btn-sm btn-outline-secondary fw-bold flex-fill">
                                        <i class="bi bi-pencil-square me-1"></i>Düzenle
                                    </a>
                                    <!-- Sil Butonu (Link yerine Modal tetikleyici butona çevrildi) -->
                                    <button type="button" class="btn btn-sm btn-outline-danger fw-bold flex-fill" data-bs-toggle="modal" data-bs-target="#deleteModal-@car.Id">
                                        <i class="bi bi-trash me-1"></i>Sil
                                    </button>
                                </div>

                                <!-- Silme Onay Modalı -->
                                <div class="modal fade" id="deleteModal-@car.Id" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content border-0 shadow-lg rounded-4">
                                            
                                            <div class="modal-header border-0 pb-0 justify-content-center mt-4">
                                                <div class="d-flex align-items-center justify-content-center rounded-circle bg-danger bg-opacity-10 text-danger" style="width: 80px; height: 80px;">
                                                    <i class="bi bi-exclamation-triangle-fill fs-1"></i>
                                                </div>
                                            </div>
                                            
                                            <div class="modal-body text-center pt-4 pb-2">
                                                <h4 class="fw-bold" style="color: #112848;">Aracı Silmek İstediğinize Emin Misiniz?</h4>
                                                <p class="text-muted mb-0">
                                                    <strong>@car.Brand?.Name @car.CarModel?.Name</strong> model araç sistemden kalıcı olarak silinecektir. Bu işlem geri alınamaz.
                                                </p>
                                            </div>
                                            
                                            <div class="modal-footer border-0 d-flex justify-content-center pb-4 pt-3 gap-3">
                                                <button type="button" class="btn btn-light fw-bold px-4 py-2 border shadow-sm" data-bs-dismiss="modal">İptal / Vazgeç</button>
                                                
                                                <!-- Silme işlemini Controller'a POST eden form -->
                                                <form asp-action="Delete" asp-route-id="@car.Id" method="post">
                                                    <button type="submit" class="btn btn-danger fw-bold px-4 py-2 shadow-sm">
                                                        <i class="bi bi-trash-fill me-2"></i>Evet, Aracı Sil
                                                    </button>
                                                </form>
                                            </div>
                                            
                                        </div>
                                    </div>
                                </div>
                                
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-light border-0 shadow-sm text-center p-5 mt-4">
                    <i class="bi bi-search fs-1 text-muted mb-3 d-block"></i>
                    <h5 class="text-muted">Kriterlere uygun araç bulunamadı.</h5>
                </div>
            }
        </div>
    </div>
</div>