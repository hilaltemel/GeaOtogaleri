@{
    ViewData["Title"] = "Üye Ol";
}

<style>
    /* Konteyner sınırlarını yıkan ve resmi tüm sayfaya yayan özel sınıf */
    .full-screen-bg {
        margin: -1rem calc(-50vw + 50%) -3rem;
        background: linear-gradient(rgba(255, 255, 255, 0.40), rgba(255, 255, 255, 0.40)), url('/images/girişArkaPlan.jpeg') center/cover no-repeat;
        min-height: calc(100vh - 130px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 4rem 1rem;
    }
</style>

<div class="full-screen-bg">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-7 col-lg-5 col-xl-4">
                
                <!-- Kayıt Kartı -->
                <div class="card border-0 shadow-lg rounded-4 overflow-hidden" style="background-color: rgba(255, 255, 255, 0.95);">
                    <div class="card-body p-4 p-sm-5">
                        
                        <div class="text-center mb-5">
                            <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3 shadow-sm" style="width: 70px; height: 70px; background-color: #112848;">
                                <i class="bi bi-person-plus-fill text-white fs-1"></i>
                            </div>
                            <h3 class="fw-bold mb-1" style="color: #112848;">Yeni Hesap Oluştur</h3>
                            <p class="text-muted small">Aramıza katılmak için formu doldurun.</p>
                        </div>

                        <!-- Form -->
                        <form asp-controller="Account" asp-action="Register" method="post">
                            
                            <!-- Kullanıcı Adı -->
                            <div class="mb-4">
                                <label class="form-label text-muted small fw-bold text-uppercase" style="letter-spacing: 0.5px;">Kullanıcı Adı</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0 text-muted px-3">
                                        <i class="bi bi-person"></i>
                                    </span>
                                    <input type="text" name="UserName" class="form-control form-control-lg border-start-0 shadow-none ps-0 fs-6" placeholder="Örn: ahmet_yilmaz" required />
                                </div>
                                <div class="form-text mt-2 small text-muted">Kullanıcı adınızda boşluk olmamalıdır.</div>
                            </div>

                            <!-- Şifre -->
                            <div class="mb-5">
                                <label class="form-label text-muted small fw-bold text-uppercase" style="letter-spacing: 0.5px;">Şifre</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0 text-muted px-3">
                                        <i class="bi bi-shield-lock"></i>
                                    </span>
                                    <input type="password" name="Password" class="form-control form-control-lg border-start-0 shadow-none ps-0 fs-6" placeholder="Şifrenizi belirleyin" required />
                                </div>
                            </div>

                            <!-- Kayıt Butonu -->
                            <button type="submit" class="btn w-100 text-white fw-bold py-3 shadow-sm rounded-3 mb-3 transition-hover" style="background-color: #112848; font-size: 1.05rem;">
                                Kayıt Ol <i class="bi bi-arrow-right ms-1"></i>
                            </button>

                            <!-- Giriş Linki -->
                            <div class="text-center mt-4 pt-4 border-top">
                                <span class="text-muted small">Zaten bir hesabınız var mı?</span><br />
                                <a asp-controller="Account" asp-action="Login" class="fw-bold text-decoration-none mt-1 d-inline-block" style="color: #112848;">Giriş Yap</a>
                            </div>

                        </form>
                    </div>
                </div>
                
            </div>
        </div>
    </div>
</div>