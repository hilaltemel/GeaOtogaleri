@model Car_Dealership.Models.User
@{
    ViewData["Title"] = "Profil Ayarları";
}

<style>
    /* Konteyner sınırlarını yıkan ve resmi tüm sayfaya yayan özel sınıf */
    .full-screen-bg {
        margin: -1rem calc(-50vw + 50%) -3rem;
        background: linear-gradient(rgba(255, 255, 255, 0.40), rgba(255, 255, 255, 0.40)), url('/images/girişArkaPlan.jpeg') center/cover no-repeat;
        min-height: calc(100vh - 130px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 4rem 1rem;
    }
</style>

<div class="full-screen-bg">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-7 col-lg-5 col-xl-4">
                
                <!-- Profil Kartı -->
                <div class="card border-0 shadow-lg rounded-4 overflow-hidden" style="background-color: rgba(255, 255, 255, 0.95);">
                    <div class="card-body p-4 p-sm-5">
                        
                        <div class="text-center mb-5">
                            <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3 shadow-sm" style="width: 70px; height: 70px; background-color: #112848;">
                                <i class="bi bi-person-gear text-white fs-1"></i>
                            </div>
                            <h3 class="fw-bold mb-1" style="color: #112848;">Profil Ayarları</h3>
                            <p class="text-muted small">Hesap bilgilerinizi buradan güncelleyebilirsiniz.</p>
                        </div>

                        <!-- Form -->
                        <form asp-controller="Account" asp-action="Profile" method="post">
                            
                            <!-- Kullanıcı Adı -->
                            <div class="mb-4">
                                <label asp-for="UserName" class="form-label text-muted small fw-bold text-uppercase" style="letter-spacing: 0.5px;">Kullanıcı Adı</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0 text-muted px-3">
                                        <i class="bi bi-person"></i>
                                    </span>
                                    <input asp-for="UserName" class="form-control form-control-lg border-start-0 shadow-none ps-0 fs-6" required />
                                </div>
                            </div>

                            <!-- Şifre -->
                            <div class="mb-5">
                                <label asp-for="Password" class="form-label text-muted small fw-bold text-uppercase" style="letter-spacing: 0.5px;">Yeni Şifre</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0 text-muted px-3">
                                        <i class="bi bi-shield-lock"></i>
                                    </span>
                                    <!-- Value kısmı boş bırakıldı, Placeholder eklendi -->
                                    <input type="password" name="Password" class="form-control form-control-lg border-start-0 shadow-none ps-0 fs-6" placeholder="Değiştirmek istemiyorsanız boş bırakın" />
                                </div>
                                <div class="form-text mt-2 small text-muted">
                                    Mevcut şifreniz: <strong class="text-dark">@Model.Password</strong>
                                </div>
                            </div>

                            <!-- Kaydet Butonu -->
                            <button type="submit" class="btn w-100 text-white fw-bold py-3 shadow-sm rounded-3 transition-hover" style="background-color: #112848; font-size: 1.05rem;">
                                <i class="bi bi-check2-circle me-1"></i> Değişiklikleri Kaydet
                            </button>

                            <!-- Güvenli Çıkış (Opsiyonel Ekstra UX) -->
                            <div class="text-center mt-4 pt-4 border-top">
                                <a asp-controller="Account" asp-action="Logout" class="fw-bold text-danger text-decoration-none small">
                                    <i class="bi bi-box-arrow-right me-1"></i> Hesaptan Çıkış Yap
                                </a>
                            </div>

                        </form>
                    </div>
                </div>
                
            </div>
        </div>
    </div>
</div>