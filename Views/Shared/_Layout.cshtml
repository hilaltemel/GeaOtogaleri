<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GEA OTOGALERİ</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Car_Dealership.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        .text-gea { color: #112848 !important; }
        .border-gea { border-color: #112848 !important; }
    </style>
    <link rel="icon" type="image/png" href="~/images/newLogo2.png">
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white shadow-sm" style="border-bottom: 2px solid #112848;">
            <div class="container-fluid px-md-5">
                
                <!-- MERKEZDEKİ LOGO / MARKA -->
                <a class="navbar-brand position-absolute start-50 translate-middle-x" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/images/newlogo2.png" alt="Gea Otogaleri Logosu" style="height: 60px; object-fit: contain;" />
                </a>
                
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Menüyü Aç/Kapat">
                    <span class="navbar-toggler-icon"></span>
                </button>
                
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    
                    <!-- MENÜ LİNKLERİ (Eşit Dağılım ve Aktif Sayfa Vurgusu) -->
                    <ul class="navbar-nav d-flex justify-content-evenly w-50 pe-5">
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "text-gea fw-bold" : "text-dark")" asp-area="" asp-controller="Home" asp-action="Index">Ana Sayfa</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Cars" ? "text-gea fw-bold" : "text-dark")" asp-area="" asp-controller="Cars" asp-action="Index">Araçlar</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["Action"]?.ToString() == "Campaigns" ? "text-gea fw-bold" : "text-dark")" asp-area="" asp-controller="Home" asp-action="Campaigns">Kampanyalar</a>
                        </li>
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Admin" ? "text-gea fw-bold" : "text-dark")" asp-area="" asp-controller="Admin" asp-action="Index">
                                    <i class="bi bi-speedometer2 me-1"></i> Yönetim Paneli
                                </a>
                            </li>
                        }
                    </ul>
                    
                    <!-- BÜYÜTEÇLİ ARAMA ÇUBUĞU VE PROFİL -->
                    <div class="d-flex align-items-center justify-content-end w-50">
                        
                        <!-- Büyüteç İkonlu ve Uzatılmış Arama Formu -->
                        <form asp-controller="Admin" asp-action="Index" method="get" class="d-flex me-4" style="width: 280px;">
                            <div class="input-group shadow-sm rounded-pill">
                                <input class="form-control rounded-start-pill border-end-0 bg-light" type="search" placeholder="Araç, marka veya model ara..." aria-label="Search" name="searchQuery">
                                <button class="btn btn-light bg-light rounded-end-pill border border-start-0 text-muted d-flex align-items-center justify-content-center" type="submit">
                                    <img src="~/images/searchIcon.png" alt="Ara" style="width: 18px; height: 18px; opacity: 0.7;">
                                </button>
                            </div>
                        </form>
                        
                        <!-- Orijinal Profil Menüsü / Giriş ve Kayıt Alanı -->
                        @if (User.Identity!.IsAuthenticated)
                        {
                            <div class="nav-item dropdown">
                                <a class="nav-link d-flex align-items-center p-0" href="#" id="profileDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <img src="~/images/profil_resmi.jpeg" alt="Profil" class="rounded-circle border border-2 border-gea shadow-sm" style="width: 40px; height: 40px; object-fit: cover;">
                                    <span class="ms-2 fw-bold text-dark d-none d-sm-block">@User.Identity.Name</span>
                                </a>
                                
                                <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 mt-2" aria-labelledby="profileDropdown">
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Account" asp-action="Profile">
                                            <i class="bi bi-shield-lock me-2 text-secondary"></i>Profil Ayarları
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item py-2 text-danger fw-bold" asp-controller="Account" asp-action="Logout">
                                            <i class="bi bi-box-arrow-right me-2"></i>Çıkış Yap
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <div class="nav-item">
                                <a class="nav-link d-flex align-items-center p-0" href="/Account/Login" title="Giriş Yap">
                                    <img src="~/images/profil_resmi.jpeg" alt="Giriş Yap" class="rounded-circle border border-2 border-secondary shadow-sm opacity-75 hover-opacity-100 transition" style="width: 40px; height: 40px; object-fit: cover;">
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </nav>
</header>
<!-- Eğer tam ekran sayfalardaysak 'container-fluid px-0', değilsek standart 'container' kullan -->
    @await RenderSectionAsync("Hero", required: false)

    <!-- STANDART GÜVENLİ KUTU (Diğer tüm sayfalar ve alt içerikler için) -->
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    
    <footer class="footer mt-auto py-5" style="background-color: #112848; color: #ffffff;">
        <div class="container">
            <div class="row gy-4">
                
                <!-- 1. Sütun: Marka ve Açıklama -->
                <div class="col-lg-4 col-md-6">
                    <h5 class="fw-bold mb-3 text-white">GEA OTOGALERİ</h5>
                    <p class="small text-white-50 mb-3">
                        Premium araç satış ve danışmanlık hizmetlerinde güvenilir adresiniz. 
                        En yeni modeller ve fırsatlar için vitrinimizi takip edin.
                    </p>
                    <p class="small text-white-50 mb-0">
                        &copy; 2026 Gea Otogaleri. Tüm Hakları Saklıdır.
                    </p>
                </div>

                <!-- 2. Sütun: Hızlı Bağlantılar -->
                <div class="col-lg-4 col-md-6">
                    <h6 class="fw-bold mb-3 text-white">Hızlı Menü</h6>
                    <ul class="list-unstyled small">
                        <li class="mb-2"><a asp-controller="Home" asp-action="Index" class="text-white-50 text-decoration-none hover-text-white">Ana Sayfa</a></li>
                        <li class="mb-2"><a asp-controller="Cars" asp-action="Index" class="text-white-50 text-decoration-none hover-text-white">Tüm Araçlar</a></li>
                        <li class="mb-2"><a asp-controller="Home" asp-action="Campaigns" class="text-white-50 text-decoration-none hover-text-white">Kampanyalar</a></li>
                        <li class="mb-2"><a asp-controller="Home" asp-action="Privacy" class="text-white-50 text-decoration-none hover-text-white">Gizlilik Politikası</a></li>
                    </ul>
                </div>

                <!-- 3. Sütun: İletişim ve Geliştirici -->
                <div class="col-lg-4 col-md-12">
                    <h6 class="fw-bold mb-3 text-white">İletişim</h6>
                    <ul class="list-unstyled small text-white-50 mb-4">
                        <li class="mb-2"><i class="bi bi-geo-alt-fill me-2"></i>İstanbul, Türkiye</li>
                        <li class="mb-2"><i class="bi bi-telephone-fill me-2"></i>+90 999 999 99 99</li>
                        <li class="mb-2"><i class="bi bi-envelope-fill me-2"></i>info@geaotogaleri.com</li>
                    </ul>
                    
                    <!-- Geliştirici İmzası -->
                    <div class="mt-3 pt-3" style="border-top: 1px solid rgba(255,255,255,0.1);">
                        <span class="small text-white-50" style="letter-spacing: 0.5px;">
                            Developed by <span class="fw-bold text-white">Hilal Temel</span>
                        </span>
                    </div>
                </div>

            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
