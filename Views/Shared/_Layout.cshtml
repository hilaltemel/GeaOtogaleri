    @await RenderSectionAsync("Scripts", required: false)
    <script>
    document.addEventListener("DOMContentLoaded", function () {
        const dateInput = document.getElementById("appointmentDateInput");
        const timeSelect = document.getElementById("appointmentTimeSelect");

        if(dateInput && timeSelect) {
            
            // 1. GEÇMİŞ TARİHLERİ ENGELLE (Yerel saat dilimine tam uyumlu)
            const now = new Date();
            const year = now.getFullYear();
            const month = String(now.getMonth() + 1).padStart(2, '0');
            const day = String(now.getDate()).padStart(2, '0');
            const todayString = `${year}-${month}-${day}`; // "2026-09-09" formatı
            
            dateInput.setAttribute('min', todayString);

            // 2. TARİH SEÇİLDİĞİNDE SAATLERİ FİLTRELE
            dateInput.addEventListener("change", function () {
                const selectedDate = this.value;
                const isToday = selectedDate === todayString;
                const currentHour = new Date().getHours(); // İçinde bulunduğumuz saat (örn: 15)
                
                // Önce dropdown'ı sıfırla (tüm saatleri aç ve yazıları düzelt)
                Array.from(timeSelect.options).forEach(option => {
                    if (option.value !== "") {
                        option.disabled = false;
                        option.text = option.value; // Örn: "09:00 - 10:00 (DOLU)" ise temizle
                        
                        // EĞER BUGÜNSE: Geçmiş ve mevcut saatleri kapat
                        if (isToday) {
                            // "09:00 - 10:00" içinden '09' kısmını alıp sayıya (9) çeviriyoruz
                            const slotStartHour = parseInt(option.value.split(':')[0], 10);
                            
                            // Eğer randevunun başlangıç saati, şu anki saate eşit veya daha küçükse kapat
                            if (slotStartHour <= currentHour) {
                                option.disabled = true;
                                option.text = option.value + " (SÜRESİ GEÇTİ)";
                            }
                        }
                    }
                });

                // 3. VERİTABANINDAN DOLU SAATLERİ ÇEK VE KAPAT
                fetch(`/Home/GetBookedTimes?date=${selectedDate}`)
                    .then(response => response.json())
                    .then(bookedTimes => {
                        Array.from(timeSelect.options).forEach(option => {
                            // Eğer bu saat veritabanında doluysa ve süresi geçtiği için zaten kapatılmamışsa
                            if (bookedTimes.includes(option.value)) {
                                option.disabled = true;
                                option.text = option.value + " (DOLU)";
                            }
                        });
                    })
                    .catch(error => console.error('Hata:', error));
            });
        }
    });
        function toggleFavorite(event, carId, buttonElement) {
        // 1. Tıklamanın karta veya linke sıçramasını kesin olarak durdurur!
        event.preventDefault();
        event.stopPropagation();

        var icon = buttonElement.querySelector('i');
        
        fetch(`/Cars/ToggleFavorite?carId=${carId}`, {
            method: 'POST'
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                if (data.isFavorite) {
                    icon.classList.remove('bi-heart', 'text-muted');
                    icon.classList.add('bi-heart-fill', 'text-danger');
                } else {
                    icon.classList.remove('bi-heart-fill', 'text-danger');
                    icon.classList.add('bi-heart', 'text-muted');
                }
            } else {
                alert(data.message); // Eğer giriş yapmamışsa uyarı ver
            }
        })
        .catch(error => console.error('Hata:', error));
    }
</script>
<script>
    // 1. Sayfa yüklendiğinde çalışacak kod:
    document.addEventListener("DOMContentLoaded", function () {
        var currentCount = @discountNotifications.Count;
        var savedCount = localStorage.getItem('readDiscountCount');

        // Eğer kullanıcı bu sayıdaki bildirimi daha önce gördüyse (tıkladıysa), rozeti baştan gizle
        if (savedCount && parseInt(savedCount) >= currentCount) {
            var badge = document.getElementById('notificationBadge');
            if (badge) {
                badge.style.display = 'none';
            }
        }
    });

    // 2. Çana tıklandığında çalışacak kod:
    function markAsRead(count) {
        var badge = document.getElementById('notificationBadge');
        if (badge) {
            badge.style.display = 'none'; // Kırmızı rozeti ekrandan anında sil
        }
        // Kullanıcının tarayıcısına "Bu kişi X adet indirimi gördü" bilgisini kaydet
        localStorage.setItem('readDiscountCount', count);
    }
</script>
<script>
    // ARABA SEÇİMİNİ OTOMATİK YAPAN BAĞIMSIZ FONKSİYON
    function setAppointmentCar(carId) {
        // Modal içindeki açılır menüyü bul (ID'si CarId olmalı)
        const carSelect = document.getElementById('CarId'); 
        
        if (carSelect) {
            // Eğer carId boş gelirse (örn: Navbar'dan basıldığında) seçimi sıfırla
            if(carId === '' || carId === null) {
                carSelect.value = '';
            } else {
                // Karttan basıldıysa o arabanın ID'sini seçili yap
                carSelect.value = carId;
            }
        } else {
            console.error("HATA: 'CarId' ID'sine sahip dropdown menüsü bulunamadı!");
        }
    }
</script>
</body>
</html>
