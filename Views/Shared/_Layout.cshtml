@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@using Car_Dealership.Models
@inject ApplicationDbContext _context

@{
    var discountNotifications = new List<Car_Dealership.Models.Car>();
    
    if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        var userIdStr = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (!string.IsNullOrEmpty(userIdStr))
        {
            long currentUserId = long.Parse(userIdStr);
            
            // Favorilerdeki araçlardan "İlk Fiyatı dolu olan ve Şu anki Fiyatı İlk Fiyatından düşük olanları" (İndirimdekileri) getir
            discountNotifications = _context.Favorites
                .Include(f => f.Car)
                    .ThenInclude(c => c!.Brand)
                .Include(f => f.Car)
                    .ThenInclude(c => c!.CarModel)
                .Include(f => f.Car)
                    .ThenInclude(c => c!.Images)
                .Where(f => f.UserId == currentUserId && f.Car != null && f.Car.FirstPrice != null && f.Car.CurrentPrice < f.Car.FirstPrice)
                .Select(f => f.Car!)
                .ToList();
        }
    }
}

