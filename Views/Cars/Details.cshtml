@model Car_Dealership.Models.Car
@{
    ViewData["Title"] = "Araç Detayları";
}

<div class="container mt-5 pt-3 mb-5">
    
    <!-- Üst Bar: Başlık ve Geri Butonu -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold" style="color: #112848;">Araç Detayları</h3>
        <a href="javascript:void(0);" onclick="history.back();" class="btn btn-outline-secondary shadow-sm px-4">
            <i class="bi bi-arrow-left me-2"></i> Geri Dön
        </a>
    </div>

    <div class="row g-4">
        
        <!-- SOL KOLON: Görsel Galerisi (Carousel) -->
        <div class="col-lg-7">
            <div id="carGallery" class="carousel slide shadow-sm rounded-4 overflow-hidden h-100" data-bs-ride="carousel">
                <div class="carousel-inner h-100">
                    @if (Model.Images != null && Model.Images.Any())
                    {
                        var first = true;
                        foreach (var img in Model.Images)
                        {
                            <div class="carousel-item h-100 @(first ? "active" : "")">
                                <img src="~/images/@img.ImagePath" class="d-block w-100 h-100" style="object-fit: cover; min-height: 450px; max-height: 550px;" alt="Araç Görseli">
                            </div>
                            first = false;
                        }
                    }
                    else
                    {
                        <div class="carousel-item active h-100">
                            <div class="d-flex align-items-center justify-content-center bg-light w-100 h-100" style="min-height: 450px;">
                                <i class="bi bi-camera fs-1 text-muted"></i>
                            </div>
                        </div>
                    }
                </div>
                
                <!-- Birden fazla resim varsa okları göster -->
                @if (Model.Images != null && Model.Images.Count > 1)
                {
                    <button class="carousel-control-prev" type="button" data-bs-target="#carGallery" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Önceki</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#carGallery" data-bs-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Sonraki</span>
                    </button>
                }
            </div>
        </div>

        <!-- SAĞ KOLON: Özet Bilgiler ve Fiyat -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4 p-md-5 d-flex flex-column">
                    
                    <h6 class="text-muted text-uppercase mb-1" style="letter-spacing: 1px;">@Model.Brand?.Name</h6>
                    <h2 class="fw-bold mb-4" style="color: #112848;">@Model.CarModel?.Name</h2>

                    <!-- Fiyat Alanı -->
                    <h2 class="fw-bold text-success mb-4 pb-4 border-bottom">@Model.CurrentPrice.ToString("N0") TL</h2>

                    <!-- Liste Şeklinde Özellikler -->
                    <ul class="list-unstyled mb-5 flex-grow-1">
                        <li class="d-flex justify-content-between align-items-center py-3 border-bottom">
                            <span class="text-muted fw-bold"><i class="bi bi-palette me-2 fs-5" style="color: #112848;"></i>Renk</span>
                            <span class="fw-bold text-dark">@Model.Color</span>
                        </li>
                        <li class="d-flex justify-content-between align-items-center py-3 border-bottom">
                            <span class="text-muted fw-bold"><i class="bi bi-gear-wide-connected me-2 fs-5" style="color: #112848;"></i>Vites Tipi</span>
                            <span class="fw-bold text-dark">@Model.TransmissionType</span>
                        </li>
                        <li class="d-flex justify-content-between align-items-center py-3 border-bottom">
                            <span class="text-muted fw-bold"><i class="bi bi-fuel-pump me-2 fs-5" style="color: #112848;"></i>Yakıt Tipi</span>
                            <span class="fw-bold text-dark">@Model.FuelType</span>
                        </li>
                        <li class="d-flex justify-content-between align-items-center py-3 border-bottom">
                            <span class="text-muted fw-bold"><i class="bi bi-tag me-2 fs-5" style="color: #112848;"></i>Satış Durumu</span>
                            @if (Model.IsOnSale)
                            {
                                <span class="badge bg-success px-3 py-2 rounded-pill">Satışta</span>
                            }
                            else
                            {
                                <span class="badge bg-danger px-3 py-2 rounded-pill">Satıldı</span>
                            }
                        </li>
                    </ul>

                    <!-- Aksiyon Butonu -->
                    <a href="mailto:info@geaotogaleri.com" class="btn w-100 text-white fw-bold py-3 shadow-sm rounded-3 mt-auto" style="background-color: #112848; font-size: 1.1rem;">
                        <i class="bi bi-headset me-2"></i> Satış Temsilcisine Ulaş
                    </a>
                    <div class="d-grid mt-2">
                        <button type="button" class="btn w-100 text-white fw-bold py-3 shadow-sm rounded-3 mt-auto" style="background-color: #112848; font-size: 1.1rem;"
                                data-bs-toggle="modal" data-bs-target="#appointmentModal" 
                                onclick="setAppointmentCar(@Model.Id)"
                                style="background-color: #112848; transition: all 0.3s ease;">
                            <i class="bi bi-calendar-plus me-2"></i> Bu Araç İçin Randevu Al
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ALT BÖLÜM: Donanım ve Açıklama -->
    <div class="col-12">
        <!-- Ortak Özellikler Alanı -->
        <div class="card mb-4 border-0 shadow-sm rounded-4">
            <div class="card-body p-4">
                <h5 class="mb-4" style="color: #112848;"><i class="bi bi-info-circle me-2"></i>Temel Araç Bilgileri</h5>
                <dl class="row mb-0" style="font-size: 0.95rem;">
                    <dt class="col-sm-4 text-muted">Araç Durumu</dt>
                    <dd class="col-sm-8 fw-bold">@(Model.IsSecondHand ? "İkinci El" : "Sıfır")</dd>

                    <dt class="col-sm-4 text-muted">Seri / Yıl</dt>
                    <dd class="col-sm-8">@Model.Series - @Model.Year</dd>

                    <dt class="col-sm-4 text-muted">Motor</dt>
                    <dd class="col-sm-8">@Model.EnginePower HP / @Model.EngineCapacity cc</dd>

                    <dt class="col-sm-4 text-muted">Kasa / Çekiş</dt>
                    <dd class="col-sm-8">@Model.BodyType / @Model.Drivetrain</dd>

                    <dt class="col-sm-4 text-muted">Garanti</dt>
                    <dd class="col-sm-8">@(Model.HasWarranty ? "Mevcut" : "Yok")</dd>
                </dl>
            </div>
        </div>

        <!-- Sadece İkinci El İse Görünecek Alan -->
        @if (Model.IsSecondHand)
        {
            <div class="card mb-4 border-0 shadow-sm rounded-4" style="background-color: #f8f9fa;">
                <div class="card-body p-4">
                    <h5 class="mb-4 text-secondary"><i class="bi bi-car-front me-2"></i>İkinci El Detayları</h5>
                    <dl class="row mb-0" style="font-size: 0.95rem;">
                        <dt class="col-sm-4 text-muted">Kilometre</dt>
                        <dd class="col-sm-8 fw-bold">@string.Format("{0:N0} km", Model.Mileage)</dd>

                        <dt class="col-sm-4 text-muted">Plaka</dt>
                        <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.Plate) ? "-" : Model.Plate)</dd>

                        <dt class="col-sm-4 text-muted">Boya / Değişen</dt>
                        <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.PaintAndChangedStatus) ? "Belirtilmemiş" : Model.PaintAndChangedStatus)</dd>

                        <dt class="col-sm-4 text-muted">Muayene Tarihi</dt>
                        <dd class="col-sm-8">@(Model.InspectionDate?.ToString("dd/MM/yyyy") ?? "Belirtilmemiş")</dd>

                        <dt class="col-sm-4 text-muted">Ağır Hasar Kaydı</dt>
                        <dd class="col-sm-8 @(Model.HeavyDamageRecord == true ? "text-danger fw-bold" : "")">
                            @(Model.HeavyDamageRecord == true ? "Var" : (Model.HeavyDamageRecord == false ? "Yok" : "Belirtilmemiş"))
                        </dd>

                        <dt class="col-sm-4 text-muted">Takas Durumu</dt>
                        <dd class="col-sm-8 @(Model.IsTradeInEligible == true ? "text-success fw-bold" : "")">
                            @(Model.IsTradeInEligible == true ? "Takasa Uygun" : (Model.IsTradeInEligible == false ? "Uygun Değil" : "Belirtilmemiş"))
                        </dd>
                    </dl>
                </div>
            </div>
        }
    </div>
</div>