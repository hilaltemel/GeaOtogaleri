@model List<Car_Dealership.Models.Car>
@{
    ViewData["Title"] = "Favorilerim";
}
<div class="container mt-5 pt-3 mb-5">
    <div class="row">
        <div class="col-lg">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4 class="fw-bold mb-0" style="color: #112848;">FAVORİLERİM</h4>
            </div>
             @if (Model.Any())
            {
                <!-- Satır başına 3 kart -->
                <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                    @foreach (Car car in Model)
                    {
                        <div class="col">
                            <a asp-controller="Cars" asp-action="Details" asp-route-id="@car.Id" class="text-dark text-decoration-none h-100 d-block">
                                <div class="card h-100 shadow-sm border-0 transition-hover">
                                    <button onclick="toggleFavorite(event, @car.Id, this)" class="btn btn-light rounded-circle shadow-sm position-absolute d-flex justify-content-center align-items-center" style="top: 10px; right: 10px; width: 40px; height: 40px; z-index: 10; border: none;">
                                        <i class="bi bi-heart-fill fs-5 text-danger"></i>
                                    </button>
                                    <!-- Kapak Resmi -->
                                    @{ var kapakResmi = car.Images?.FirstOrDefault()?.ImagePath; }
                                    @if (!string.IsNullOrEmpty(kapakResmi))
                                    {
                                        <img src="~/images/@kapakResmi" class="card-img-top rounded-top" alt="Araç Görseli" style="height: 180px; object-fit: cover;">
                                    }
                                    else
                                    {
                                        <div class="card-img-top rounded-top bg-secondary d-flex align-items-center justify-content-center text-white" style="height: 180px;">
                                            <i class="bi bi-camera fs-1"></i>
                                        </div>
                                    }
                                    <div class="card-body d-flex flex-column pt-3">
                                        <p class="text-muted mb-1 text-uppercase" style="font-size: 0.70rem; letter-spacing: 1px;">
                                            @car.Brand?.Name
                                        </p>
                                        <h6 class="card-title fw-bold text-dark mb-3 text-truncate">
                                            @car.CarModel?.Name
                                        </h6>
                                        <div class="mt-auto pt-2 border-top">
                                            <h5 class="fw-bold m-0" style="color: #112848; font-size: 1.05rem;">@car.CurrentPrice.ToString("N0") TL</h5>
                                        </div>
                                    </div>
                                </div>
                            </a>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>