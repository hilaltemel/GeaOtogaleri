@model List<Car_Dealership.Models.Car>
@{
    ViewData["Title"] = "Arama Sonuçları";
}

<div class="container mt-5 pt-3 mb-5">
    <div class="row mb-4">
        <div class="col-12">
            <h4 class="fw-bold" style="color: #112848;">
                "<span class="text-primary">@ViewBag.SearchQuery</span>" için Arama Sonuçları
            </h4>
            <p class="text-muted">Toplam @Model.Count araç bulundu.</p>
        </div>
    </div>

    @if (Model.Any())
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4">
            @foreach (var car in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 transition-hover position-relative">
                        
                        <!-- Dinamik Favori Kalbimiz -->
                        @{
                            var favIds = ViewBag.UserFavIds as List<long> ?? new List<long>();
                            string heartClass = favIds.Contains(car.Id) ? "bi-heart-fill text-danger" : "bi-heart text-muted";
                        }
                        <button onclick="toggleFavorite(event, @car.Id, this)" class="btn btn-light rounded-circle shadow-sm position-absolute d-flex justify-content-center align-items-center" style="top: 10px; right: 10px; width: 40px; height: 40px; z-index: 10; border: none;">
                            <i class="bi @heartClass fs-5"></i>
                        </button>

                        <a asp-controller="Cars" asp-action="Details" asp-route-id="@car.Id" class="text-dark text-decoration-none d-block h-100">
                            <!-- Araç Resmi -->
                            @{ var kapakResmi = car.Images?.FirstOrDefault()?.ImagePath; }
                            @if (!string.IsNullOrEmpty(kapakResmi))
                            {
                                <img src="~/images/@kapakResmi" class="card-img-top rounded-top" style="height: 200px; object-fit: cover;" alt="Araç Görseli">
                            }
                            else
                            {
                                <div class="card-img-top rounded-top bg-secondary d-flex align-items-center justify-content-center" style="height: 200px;">
                                    <i class="bi bi-camera fs-1 text-white"></i>
                                </div>
                            }

                            <!-- Araç Detayları -->
                            <div class="card-body d-flex flex-column pt-3">
                                <p class="text-muted small fw-bold text-uppercase mb-1" style="letter-spacing: 1px;">@car.Brand?.Name</p>
                                <h6 class="card-title fw-bold text-dark mb-3">@car.CarModel?.Name</h6>
                                
                                <div class="mt-auto pt-2 border-top">
                                    <h5 class="fw-bold m-0" style="color: #112848;">@car.CurrentPrice.ToString("N0") ₺</h5>
                                </div>
                            </div>
                        </a>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <!-- Aranan kelimede araç bulunamazsa çıkacak ekran -->
        <div class="text-center py-5">
            <i class="bi bi-search fs-1 text-muted mb-3 d-block"></i>
            <h5 class="fw-bold text-muted">Aradığınız kriterlere uygun araç bulunamadı.</h5>
            <p>Lütfen farklı bir marka veya model ile tekrar deneyin.</p>
            <a href="/" class="btn btn-primary mt-3 px-4 rounded-pill">Ana Sayfaya Dön</a>
        </div>
    }
</div>